# Server
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (docker-compose service name "postgres" when running in Docker)
DATABASE_URL=postgresql://registry:registry@localhost:5432/registry?schema=public

# Redis (rate limiting, refresh-token denylist)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com

# Object storage (S3-compatible: AWS S3, Cloudflare R2, or local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=registry-listings
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_URL=http://localhost:9000/registry-listings
