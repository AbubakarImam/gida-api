# Server
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (docker-compose service name "postgres" when running in Docker)
DATABASE_URL=postgresql://gidalisting:gidalisting@localhost:5432/gidalisting?schema=public

# Redis (rate limiting, refresh-token denylist)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com

# Object storage — S3-compatible client, pointed at local MinIO for dev and
# Cloudflare R2 in production (R2's API is S3-compatible, so no code differs
# between the two — only these values change).
#
# Local dev (MinIO, via docker-compose): the values below already match.
# Production (R2): S3_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   (Cloudflare dashboard -> R2 -> Manage API Tokens for the key pair),
#   S3_REGION=auto, and S3_PUBLIC_URL = the bucket's r2.dev URL or your own
#   custom domain mapped to it.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gidalisting-listings
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_URL=http://localhost:9000/gidalisting-listings
